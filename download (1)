<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Archive | Digital Nexus</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0a0a0f;
            --bg-darker: #05050a;
            --bg-card: #16161f;
            --bg-card-hover: #1d1d28;
            --text-light: #ffffff;
            --text-gray: #8b8b92;
            --text-dim: #5a5a64;
            --purple-primary: #a855f7;
            --purple-dark: #7c3aed;
            --pink-accent: #ec4899;
            --orange-accent: #ff8c00;
            --cyan-accent: #06b6d4;
            --border-color: rgba(168, 85, 247, 0.3);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --glow: 0 0 15px rgba(168, 85, 247, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        header {
            background: var(--bg-card);
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-light);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--purple-primary), var(--pink-accent));
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        nav ul {
            display: flex;
            list-style: none;
        }

        nav ul li {
            margin-left: 30px;
            position: relative;
        }

        nav ul li a {
            text-decoration: none;
            color: var(--text-gray);
            font-weight: 500;
            transition: var(--transition);
            padding: 8px 0;
        }

        nav ul li a:hover {
            color: var(--text-light);
        }

        nav ul li a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--orange-accent);
            transition: width 0.3s;
        }

        nav ul li a:hover::after {
            width: 100%;
        }

        nav ul li a.active {
            color: var(--orange-accent);
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .search-btn, .theme-toggle {
            background: none;
            border: none;
            color: var(--text-gray);
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .search-btn:hover, .theme-toggle:hover {
            color: var(--text-light);
        }

        /* Archive Hero */
        .archive-hero {
            background: linear-gradient(135deg, var(--purple-primary), var(--pink-accent), var(--orange-accent));
            color: white;
            padding: 100px 0;
            text-align: center;
            margin-bottom: 40px;
            position: relative;
            overflow: hidden;
        }

        .archive-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path d="M0,0 L100,0 L100,100 Z" fill="rgba(255,255,255,0.1)"/></svg>');
            background-size: cover;
        }

        .archive-hero h1 {
            font-size: 3rem;
            margin-bottom: 15px;
            font-weight: 700;
            position: relative;
        }

        .archive-hero p {
            font-size: 1.2rem;
            max-width: 600px;
            margin: 0 auto;
            opacity: 0.9;
            position: relative;
        }

        /* Archive Content */
        .archive-content {
            display: grid;
            grid-template-columns: 1fr 3fr;
            gap: 30px;
            margin-bottom: 60px;
        }

        /* Sidebar */
        .archive-sidebar {
            background: var(--bg-card);
            padding: 25px;
            border-radius: 15px;
            box-shadow: var(--shadow);
            height: fit-content;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .archive-sidebar h3 {
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-light);
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .archive-sidebar h3 i {
            color: var(--orange-accent);
        }

        .filter-section {
            margin-bottom: 25px;
        }

        .filter-section h4 {
            margin-bottom: 15px;
            color: var(--text-gray);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .filter-section h4 i {
            font-size: 0.8rem;
        }

        .filter-list {
            list-style: none;
        }

        .filter-list li {
            margin-bottom: 10px;
            position: relative;
            overflow: hidden;
        }

        .filter-list a {
            color: var(--text-light);
            text-decoration: none;
            transition: var(--transition);
            display: flex;
            justify-content: space-between;
            padding: 8px 12px;
            border-radius: 8px;
            position: relative;
            z-index: 1;
        }

        .filter-list a::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
            transition: left 0.5s;
            z-index: -1;
        }

        .filter-list a:hover::before {
            left: 100%;
        }

        .filter-list a:hover {
            background: var(--bg-card-hover);
        }

        .filter-list .count {
            background: var(--bg-dark);
            color: var(--text-gray);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            transition: all 0.3s;
        }

        .filter-list a:hover .count {
            background: var(--purple-primary);
            color: white;
        }

        .search-box {
            position: relative;
            margin-bottom: 25px;
        }

        .search-box input {
            width: 100%;
            background: var(--bg-dark);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 12px 15px 12px 40px;
            color: var(--text-light);
            font-size: 14px;
            transition: all 0.3s;
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--orange-accent);
            box-shadow: 0 0 0 2px rgba(255, 140, 0, 0.2);
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-gray);
        }

        /* Archive Main */
        .archive-main {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .archive-year {
            background: var(--bg-card);
            border-radius: 15px;
            box-shadow: var(--shadow);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .archive-year:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }

        .year-header {
            background: linear-gradient(90deg, var(--purple-primary), var(--pink-accent));
            color: white;
            padding: 20px;
            font-size: 1.3rem;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .year-header:hover {
            background: linear-gradient(90deg, var(--purple-dark), var(--pink-accent));
        }

        .year-header .toggle {
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .year-header.active .toggle {
            transform: rotate(180deg);
        }

        .year-content {
            padding: 0;
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
        }

        .year-content.active {
            padding: 20px;
            max-height: 10000px;
        }

        .month-section {
            margin-bottom: 25px;
            position: relative;
        }

        .month-section:last-child {
            margin-bottom: 0;
        }

        .month-header {
            font-size: 1.1rem;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--orange-accent);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .month-header::before {
            content: '';
            width: 8px;
            height: 8px;
            background: var(--orange-accent);
            border-radius: 50%;
        }

        .post-list {
            list-style: none;
        }

        .post-item {
            padding: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: var(--transition);
            border-radius: 10px;
            margin-bottom: 10px;
            position: relative;
            overflow: hidden;
        }

        .post-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.03), transparent);
            transition: left 0.5s;
        }

        .post-item:hover::before {
            left: 100%;
        }

        .post-item:hover {
            background-color: var(--bg-card-hover);
            transform: translateX(5px);
        }

        .post-item:last-child {
            border-bottom: none;
        }

        .post-date {
            color: var(--text-gray);
            font-size: 0.9rem;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .post-date::before {
            content: '📅';
            font-size: 0.8rem;
        }

        .post-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            line-height: 1.4;
        }

        .post-title a {
            color: var(--text-light);
            text-decoration: none;
            transition: var(--transition);
            background: linear-gradient(90deg, var(--text-light), var(--text-light));
            background-size: 0% 2px;
            background-repeat: no-repeat;
            background-position: left bottom;
            transition: background-size 0.3s;
        }

        .post-title a:hover {
            background-size: 100% 2px;
            color: var(--orange-accent);
        }

        .post-excerpt {
            color: var(--text-gray);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .post-meta {
            display: flex;
            gap: 15px;
            font-size: 0.85rem;
            color: var(--text-dim);
        }

        .post-meta span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .post-category {
            background: var(--purple-primary);
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            display: inline-block;
            margin-top: 10px;
        }

        /* Pagination */
        .archive-pagination {
            display: flex;
            justify-content: center;
            margin: 40px 0;
        }

        .pagination-list {
            display: flex;
            list-style: none;
            background: var(--bg-card);
            border-radius: 50px;
            padding: 8px;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .pagination-list li {
            margin: 0 5px;
        }

        .pagination-list a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            text-decoration: none;
            color: var(--text-light);
            font-weight: 500;
            transition: var(--transition);
        }

        .pagination-list a:hover {
            background-color: var(--bg-card-hover);
        }

        .pagination-list .active a {
            background: linear-gradient(135deg, var(--purple-primary), var(--pink-accent));
            color: white;
            box-shadow: 0 4px 10px rgba(168, 85, 247, 0.4);
        }

        /* Footer */
        footer {
            background: var(--bg-card);
            color: white;
            padding: 60px 0 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-section h3 {
            font-size: 1.2rem;
            margin-bottom: 20px;
            position: relative;
            padding-bottom: 10px;
            color: var(--text-light);
        }

        .footer-section h3::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 40px;
            height: 2px;
            background: linear-gradient(90deg, var(--purple-primary), var(--pink-accent));
        }

        .footer-section p {
            color: var(--text-gray);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-gray);
            text-decoration: none;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .footer-links a:hover {
            color: var(--text-light);
            transform: translateX(5px);
        }

        .footer-links a i {
            font-size: 0.8rem;
            color: var(--purple-primary);
        }

        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .social-links a {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--bg-dark);
            color: var(--text-gray);
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.3s;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .social-links a:hover {
            background: var(--purple-primary);
            color: white;
            transform: translateY(-3px);
        }

        .copyright {
            text-align: center;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        /* Stats Section */
        .archive-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--bg-card);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            box-shadow: var(--shadow);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--purple-primary), var(--pink-accent));
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 1.2rem;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 5px;
            background: linear-gradient(90deg, var(--purple-primary), var(--pink-accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-label {
            color: var(--text-gray);
            font-size: 0.9rem;
        }

        /* Floating Action Button */
        .floating-action {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: linear-gradient(135deg, var(--purple-primary), var(--pink-accent));
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 20px rgba(168, 85, 247, 0.5);
            cursor: pointer;
            transition: all 0.3s;
            z-index: 100;
        }

        .floating-action:hover {
            transform: translateY(-5px) scale(1.1);
            box-shadow: 0 6px 25px rgba(168, 85, 247, 0.7);
        }

        /* Responsive Design */
        @media (max-width: 992px) {
            .archive-content {
                grid-template-columns: 1fr;
            }
            
            .archive-sidebar {
                order: 2;
            }
            
            .archive-main {
                order: 1;
            }
            
            .footer-content {
                grid-template-columns: 1fr 1fr;
            }

            .archive-stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .header-content {
                flex-direction: column;
                text-align: center;
                gap: 15px;
            }
            
            nav ul {
                margin-top: 15px;
                justify-content: center;
                flex-wrap: wrap;
            }
            
            nav ul li {
                margin: 0 10px;
            }
            
            .archive-hero {
                padding: 80px 0;
            }
            
            .archive-hero h1 {
                font-size: 2.2rem;
            }
            
            .footer-content {
                grid-template-columns: 1fr;
            }

            .archive-stats {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 576px) {
            nav ul {
                flex-direction: column;
                gap: 10px;
            }
            
            nav ul li {
                margin: 0;
            }
            
            .year-header {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }

            .post-meta {
                flex-direction: column;
                gap: 8px;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .archive-year {
            animation: fadeIn 0.6s ease-out;
        }

        /* Scroll to top button */
        .scroll-top {
            position: fixed;
            bottom: 100px;
            right: 30px;
            width: 45px;
            height: 45px;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-gray);
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            z-index: 99;
            opacity: 0;
            visibility: hidden;
        }

        .scroll-top.visible {
            opacity: 1;
            visibility: visible;
        }

        .scroll-top:hover {
            background: var(--purple-primary);
            color: white;
            transform: translateY(-3px);
        }
    </style>
</head>
