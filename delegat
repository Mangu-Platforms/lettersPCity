<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI-Powered Snooze & Schedule - Letters City</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-dark: #0a0a0f;
            --bg-darker: #05050a;
            --bg-card: #16161f;
            --bg-card-hover: #1d1d28;
            --text-light: #ffffff;
            --text-gray: #8b8b92;
            --text-dim: #5a5a64;
            --purple-primary: #a855f7;
            --purple-dark: #7c3aed;
            --pink-accent: #ec4899;
            --orange-accent: #ff8c00;
            --blue-accent: #3b82f6;
            --green-accent: #10b981;
            --border-color: rgba(168, 85, 247, 0.3);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --gradient-primary: linear-gradient(135deg, var(--purple-primary), var(--pink-accent));
            --gradient-secondary: linear-gradient(135deg, var(--orange-accent), var(--pink-accent));
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Top Navigation */
        .top-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            margin-bottom: 40px;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .logo-link {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .logo-icon {
            width: 24px;
            height: 24px;
            background: var(--gradient-primary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .logo-text {
            color: var(--text-light);
            font-size: 14px;
            font-weight: 600;
        }

        .top-nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .top-nav-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
        }

        .top-nav-links a:hover {
            color: var(--text-light);
        }

        .top-nav-links a.active {
            color: var(--orange-accent);
        }

        .user-section {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .social-share {
            display: flex;
            gap: 10px;
        }

        .social-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-card);
            color: var(--text-gray);
            border: none;
            cursor: pointer;
            transition: all 0.3s;
        }

        .social-btn:hover {
            color: white;
            transform: translateY(-2px);
        }

        .social-btn.twitter:hover {
            background: #1da1f2;
        }

        .social-btn.linkedin:hover {
            background: #0077b5;
        }

        .social-btn.facebook:hover {
            background: #4267B2;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--gradient-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

        /* Main Header */
        .main-header {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }

        .city-logo {
            display: inline-block;
            padding: 12px 35px;
            border: 2px solid var(--orange-accent);
            border-radius: 50px;
            margin-bottom: 12px;
            background: rgba(255, 140, 0, 0.1);
        }

        .city-logo h1 {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-light);
        }

        .tagline {
            color: var(--text-gray);
            font-size: 14px;
            margin-bottom: 20px;
        }

        .ai-badge {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--gradient-primary);
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .btn {
            padding: 12px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            border: none;
            display: inline-block;
        }

        .btn-primary {
            background: var(--text-light);
            color: var(--bg-dark);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.2);
        }

        /* Main Content Layout */
        .content-layout {
            display: grid;
            grid-template-columns: 1fr 3fr;
            gap: 30px;
            margin-bottom: 50px;
        }

        /* Sidebar */
        .sidebar {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            height: fit-content;
        }

        .sidebar-title {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-title i {
            color: var(--orange-accent);
        }

        .sidebar-nav {
            list-style: none;
        }

        .sidebar-nav li {
            margin-bottom: 12px;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-gray);
            text-decoration: none;
            padding: 12px 15px;
            border-radius: 10px;
            transition: all 0.3s;
        }

        .sidebar-nav a:hover {
            background: var(--bg-card-hover);
            color: var(--text-light);
        }

        .sidebar-nav a.active {
            background: var(--bg-card-hover);
            color: var(--orange-accent);
            border-left: 3px solid var(--orange-accent);
        }

        .ai-recommendations {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .ai-recommendation {
            background: rgba(168, 85, 247, 0.1);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .ai-recommendation h4 {
            font-size: 14px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ai-recommendation p {
            font-size: 12px;
            color: var(--text-gray);
            line-height: 1.5;
        }

        /* Main Content */
        .main-content {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        /* Feature Cards */
        .feature-card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .feature-card:hover {
            border-color: var(--orange-accent);
            transform: translateY(-3px);
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--gradient-primary);
            opacity: 0;
            transition: opacity 0.3s;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .feature-icon {
            width: 60px;
            height: 60px;
            background: var(--gradient-primary);
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .feature-title {
            font-size: 22px;
            font-weight: 600;
        }

        .feature-description {
            color: var(--text-gray);
            margin-bottom: 25px;
            line-height: 1.6;
        }

        /* AI Assistant Section */
        .ai-assistant {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid var(--blue-accent);
        }

        .ai-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .ai-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .ai-title {
            font-size: 16px;
            font-weight: 600;
        }

        .ai-suggestion {
            background: rgba(59, 130, 246, 0.1);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .ai-suggestion p {
            font-size: 14px;
            margin-bottom: 10px;
        }

        .ai-actions {
            display: flex;
            gap: 10px;
        }

        .ai-action {
            padding: 8px 15px;
            background: var(--bg-card);
            border: none;
            border-radius: 6px;
            color: var(--text-light);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .ai-action:hover {
            background: var(--blue-accent);
        }

        /* Snooze Options */
        .snooze-options {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-bottom: 25px;
        }

        .snooze-option {
            background: var(--bg-darker);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }

        .snooze-option:hover {
            border-color: var(--border-color);
            transform: translateY(-2px);
        }

        .snooze-option.active {
            border-color: var(--orange-accent);
            background: rgba(255, 140, 0, 0.1);
        }

        .snooze-option.ai-recommended::after {
            content: 'AI';
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--blue-accent);
            color: white;
            font-size: 10px;
            font-weight: bold;
            padding: 3px 8px;
            border-radius: 10px;
        }

        .snooze-time {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .snooze-label {
            color: var(--text-gray);
            font-size: 13px;
        }

        /* Custom Snooze */
        .custom-snooze {
            background: var(--bg-darker);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .custom-snooze-title {
            font-size: 16px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .custom-snooze-title i {
            color: var(--orange-accent);
        }

        .custom-inputs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input-group label {
            font-size: 14px;
            color: var(--text-gray);
        }

        .input-group select,
        .input-group input {
            padding: 12px 15px;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            color: var(--text-light);
            font-size: 14px;
        }

        .input-group select:focus,
        .input-group input:focus {
            outline: none;
            border-color: var(--orange-accent);
        }

        /* Schedule Email */
        .schedule-email {
            background: var(--bg-darker);
            border-radius: 12px;
            padding: 20px;
        }

        .schedule-title {
            font-size: 16px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .schedule-title i {
            color: var(--orange-accent);
        }

        .datetime-inputs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .datetime-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .datetime-group label {
            font-size: 14px;
            color: var(--text-gray);
        }

        .datetime-group input {
            padding: 12px 15px;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            color: var(--text-light);
            font-size: 14px;
        }

        .datetime-group input:focus {
            outline: none;
            border-color: var(--orange-accent);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .btn-snooze {
            background: var(--purple-primary);
            color: white;
            padding: 14px 25px;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-snooze:hover {
            background: var(--purple-dark);
            transform: translateY(-2px);
        }

        .btn-schedule {
            background: var(--orange-accent);
            color: white;
            padding: 14px 25px;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-schedule:hover {
            background: #e67e00;
            transform: translateY(-2px);
        }

        .btn-cancel {
            background: transparent;
            color: var(--text-gray);
            padding: 14px 25px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
        }

        /* AI Analytics Card */
        .analytics-card {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .analytics-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .analytics-title {
            font-size: 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .analytics-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: var(--bg-darker);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 5px;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-label {
            color: var(--text-gray);
            font-size: 14px;
        }

        .chart-container {
            height: 200px;
            margin-top: 20px;
        }

        /* Scheduled Emails List */
        .scheduled-list {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .list-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .list-title {
            font-size: 20px;
            font-weight: 600;
        }

        .scheduled-items {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .scheduled-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: var(--bg-darker);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .scheduled-item:hover {
            border-color: var(--border-color);
        }

        .item-icon {
            width: 50px;
            height: 50px;
            background: var(--gradient-primary);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
        }

        .item-content {
            flex: 1;
        }

        .item-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .item-details {
            display: flex;
            gap: 20px;
            color: var(--text-gray);
            font-size: 13px;
        }

        .item-actions {
            display: flex;
            gap: 10px;
        }

        .item-action {
            background: transparent;
            border: none;
            color: var(--text-gray);
            cursor: pointer;
            padding: 8px;
            border-radius: 6px;
            transition: all 0.3s;
        }

        .item-action:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
        }

        .item-action.edit:hover {
            color: var(--purple-primary);
        }

        .item-action.delete:hover {
            color: var(--pink-accent);
        }

        .item-action.share:hover {
            color: var(--blue-accent);
        }

        /* Social Feed */
        .social-feed {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .feed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .feed-title {
            font-size: 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .feed-items {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .feed-item {
            background: var(--bg-darker);
            border-radius: 12px;
            padding: 20px;
            transition: all 0.3s;
        }

        .feed-item:hover {
            transform: translateY(-3px);
        }

        .feed-user {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .feed-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--gradient-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }

        .feed-user-info h4 {
            font-size: 14px;
            margin-bottom: 2px;
        }

        .feed-user-info p {
            font-size: 12px;
            color: var(--text-gray);
        }

        .feed-content {
            font-size: 14px;
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .feed-stats {
            display: flex;
            gap: 15px;
            font-size: 12px;
            color: var(--text-gray);
        }

        .feed-stat {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* Footer */
        footer {
            background: var(--bg-card);
            border-radius: 20px 20px 0 0;
            padding: 50px 40px 30px;
            margin-top: 50px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 40px;
        }

        .footer-column h3 {
            font-size: 16px;
            margin-bottom: 20px;
        }

        .footer-column p {
            color: var(--text-gray);
            font-size: 13px;
            line-height: 1.7;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: var(--text-light);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            text-align: center;
            color: var(--text-dim);
            font-size: 12px;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .content-layout {
                grid-template-columns: 1fr;
            }
            
            .snooze-options {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .feed-items {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .snooze-options {
                grid-template-columns: 1fr;
            }
            
            .custom-inputs,
            .datetime-inputs {
                grid-template-columns: 1fr;
            }
            
            .action-buttons {
                flex-direction: column;
            }
            
            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .top-nav {
                flex-wrap: wrap;
                gap: 15px;
            }

            .top-nav-links {
                width: 100%;
                justify-content: flex-start;
            }
            
            .scheduled-item {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .item-actions {
                align-self: flex-end;
            }
            
            .analytics-stats {
                grid-template-columns: 1fr;
            }
            
            .user-section {
                flex-direction: column;
                gap: 10px;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.7);
            }
            70% {
                box-shadow: 0 0 0 10px rgba(168, 85, 247, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(168, 85, 247, 0);
            }
        }

        section {
