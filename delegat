    <script>
        // Smooth scroll for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add hover effects
        document.querySelectorAll('.feature-card, .scheduled-item, .snooze-option, .feed-item').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.boxShadow = '0 10px 40px rgba(168, 85, 247, 0.2)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.boxShadow = 'none';
            });
        });

        // Snooze option selection
        const snoozeOptions = document.querySelectorAll('.snooze-option');
        snoozeOptions.forEach(option => {
            option.addEventListener('click', function() {
                snoozeOptions.forEach(opt => opt.classList.remove('active'));
                this.classList.add('active');
                
                // If custom option is selected, focus on the date input
                if (this.querySelector('.snooze-time').textContent === 'Custom') {
                    document.getElementById('snooze-date').focus();
                }
            });
        });

        // Set default date values to tomorrow
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        
        const formatDate = (date) => {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };
        
        document.getElementById('snooze-date').value = formatDate(tomorrow);
        document.getElementById('send-date').value = formatDate(tomorrow);

        // Sidebar navigation
        const sidebarLinks = document.querySelectorAll('.sidebar-nav a');
        sidebarLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                sidebarLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Analytics Chart
        const ctx = document.getElementById('analyticsChart').getContext('2d');
        const analyticsChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Snoozed Emails',
                    data: [12, 19, 8, 15, 12, 5, 2],
                    borderColor: '#a855f7',
                    backgroundColor: 'rgba(168, 85, 247, 0.1)',
                    tension: 0.4,
                    fill: true
                }, {
                    label: 'Scheduled Emails',
                    data: [5, 8, 12, 6, 9, 3, 1],
                    borderColor: '#ff8c00',
                    backgroundColor: 'rgba(255, 140, 0, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: '#8b8b92',
                            font: {
                                size: 12
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(255, 255, 255, 0.05)'
                        },
                        ticks: {
                            color: '#8b8b92'
                        }
                    },
                    x: {
                        grid: {
                            color: 'rgba(255, 255, 255, 0.05)'
                        },
                        ticks: {
                            color: '#8b8b92'
                        }
                    }
                }
            }
        });

        // AI Assistant interactions
        const aiActions = document.querySelectorAll('.ai-action');
        aiActions.forEach(action => {
            action.addEventListener('click', function() {
                if (this.textContent.includes('Apply')) {
                    this.closest('.ai-suggestion').style.background = 'rgba(16, 185, 129, 0.1)';
                    this.textContent = 'Applied!';
                    setTimeout(() => {
                        this.textContent = 'Apply Suggestion';
                        this.closest('.ai-suggestion').style.background = 'rgba(59, 130, 246, 0.1)';
                    }, 2000);
                }
            });
        });

        // Social share buttons
        const socialButtons = document.querySelectorAll('.social-btn');
        socialButtons.forEach(button => {
            button.addEventListener('click', function() {
                const platform = this.classList.contains('twitter') ? 'Twitter' : 
                               this.classList.contains('linkedin') ? 'LinkedIn' : 'Facebook';
                alert(`Sharing your email productivity on ${platform}!`);
            });
        });

        // Share buttons in scheduled items
        const shareButtons = document.querySelectorAll('.item-action.share');
        shareButtons.forEach(button => {
            button.addEventListener('click', function() {
                const emailTitle = this.closest('.scheduled-item').querySelector('.item-title').textContent;
                alert(`Sharing "${emailTitle}" with your team!`);
            });
        });
    </script>
