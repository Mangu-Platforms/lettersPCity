# Letters — environment contract
# Copy to .env.local for local development. Never commit real values.
# Production values are set in the Vercel dashboard, not here.

# Supabase project (dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the inbound-mail webhook (POST /api/mail/inbound).
# Generate with: openssl rand -hex 32
INBOUND_MAIL_WEBHOOK_SECRET=generate-a-32-byte-hex-secret

# Outbound mail. noop (default) records sends as skipped; resend delivers.
MAIL_PROVIDER=noop
# Required when MAIL_PROVIDER=resend; also used to fetch inbound bodies.
RESEND_API_KEY=
# Svix signing secret for the Resend inbound webhook (whsec_...).
RESEND_INBOUND_WEBHOOK_SECRET=
# Bearer token for the hourly domain-verification cron (>=16 chars).
CRON_SECRET=
