{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "jsx": "react",
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": false,
    "plugins": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "output", "tests"]
}
