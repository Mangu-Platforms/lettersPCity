

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Organization - Letters City</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0a0a0f;
            --bg-darker: #05050a;
            --bg-card: #16161f;
            --bg-card-hover: #1d1d28;
            --text-light: #ffffff;
            --text-gray: #8b8b92;
            --text-dim: #5a5a64;
            --purple-primary: #a855f7;
            --purple-dark: #7c3aed;
            --pink-accent: #ec4899;
            --orange-accent: #ff8c00;
            --border-color: rgba(168, 85, 247, 0.3);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Top Navigation */
        .top-nav {
            display: flex;
            align-items: center;
            gap: 40px;
            padding: 20px 0;
            margin-bottom: 40px;
        }

        .logo-link {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .logo-icon {
            width: 24px;
            height: 24px;
            background: var(--purple-primary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .logo-text {
            color: var(--text-light);
            font-size: 14px;
            font-weight: 600;
        }

        .top-nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .top-nav-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
        }

        .top-nav-links a:hover {
            color: var(--text-light);
        }

        /* Main Header */
        .main-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .city-logo {
            display: inline-block;
            padding: 12px 35px;
            border: 2px solid var(--orange-accent);
            border-radius: 50px;
            margin-bottom: 12px;
        }

        .city-logo h1 {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-light);
        }

        .tagline {
            color: var(--text-gray);
            font-size: 14px;
            margin-bottom: 20px;
        }

        .btn {
            padding: 12px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            border: none;
            display: inline-block;
        }

        .btn-primary {
            background: var(--text-light);
            color: var(--bg-dark);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.2);
        }

        /* Welcome Section */
        .welcome-section {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 30px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .welcome-section h2 {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .welcome-section p {
            color: var(--text-gray);
            font-size: 14px;
        }

        /* Organization Dashboard */
        .org-dashboard {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 25px;
            margin-bottom: 40px;
        }

        /* Sidebar */
        .org-sidebar {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            height: fit-content;
        }

        .org-sidebar h3 {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .org-sidebar h3 i {
            color: var(--purple-primary);
        }

        .org-actions {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 30px;
        }

        .org-action-btn {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 15px;
            color: var(--text-light);
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
        }

        .org-action-btn:hover {
            border-color: var(--orange-accent);
            background: rgba(255, 140, 0, 0.05);
        }

        .org-action-btn i {
            color: var(--purple-primary);
        }

        .org-stats {
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 14px;
        }

        .stat-label {
            color: var(--text-gray);
        }

        .stat-value {
            color: var(--text-light);
            font-weight: 600;
        }

        /* Main Content */
        .org-content {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .org-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 15px;
        }

        .org-tab {
            background: transparent;
            border: none;
            color: var(--text-gray);
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
            font-weight: 500;
        }

        .org-tab.active {
            background: rgba(168, 85, 247, 0.1);
            color: var(--purple-primary);
            border-bottom: 2px solid var(--orange-accent);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .tab-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .tab-header h3 {
            font-size: 20px;
        }

        .search-box {
            background: var(--bg-dark);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            width: 250px;
        }

        .search-box input {
            background: transparent;
            border: none;
            color: var(--text-light);
            width: 100%;
            outline: none;
        }

        .search-box input:focus {
            border-color: var(--orange-accent);
        }

        .search-box i {
            color: var(--text-gray);
        }

        /* Labels Grid */
        .labels-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .label-card {
            background: var(--bg-dark);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
            position: relative;
        }

        .label-card:hover {
            border-color: var(--orange-accent);
            transform: translateY(-3px);
        }

        .label-color {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            margin-bottom: 15px;
        }

        .label-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .label-desc {
            color: var(--text-gray);
            font-size: 13px;
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .label-stats {
            display: flex;
            justify-content: space-between;
            color: var(--text-dim);
            font-size: 12px;
        }

        .label-actions {
            position: absolute;
            top: 15px;
            right: 15px;
            display: flex;
            gap: 8px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .label-card:hover .label-actions {
            opacity: 1;
        }

        .label-action-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            border-radius: 6px;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            cursor: pointer;
            font-size: 12px;
        }

        .label-action-btn:hover {
            background: var(--purple-primary);
        }

        /* Folders List */
        .folders-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .folder-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: var(--bg-dark);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .folder-item:hover {
            border-color: var(--orange-accent);
        }

        .folder-icon {
            width: 40px;
            height: 40px;
            background: rgba(168, 85, 247, 0.2);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--purple-primary);
        }

        .folder-info {
            flex: 1;
        }

        .folder-name {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .folder-desc {
            color: var(--text-gray);
            font-size: 13px;
        }

        .folder-stats {
            color: var(--text-dim);
            font-size: 12px;
            display: flex;
            gap: 15px;
        }

        .folder-actions {
            display: flex;
            gap: 8px;
        }

        /* Rules List */
        .rules-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .rule-item {
            background: var(--bg-dark);
            border-radius: 15px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .rule-item:hover {
            border-color: var(--orange-accent);
        }

        .rule-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .rule-name {
            font-size: 16px;
            font-weight: 600;
        }

        .rule-status {
            font-size: 12px;
            padding: 4px 10px;
            border-radius: 20px;
            background: rgba(76, 175, 80, 0.2);
            color: #4CAF50;
        }

        .rule-status.inactive {
            background: rgba(158, 158, 158, 0.2);
            color: #9E9E9E;
        }

        .rule-conditions {
            color: var(--text-gray);
            font-size: 14px;
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .rule-actions {
            display: flex;
            gap: 10px;
        }

        .rule-action-btn {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            padding: 6px 12px;
            color: var(--text-light);
            cursor: pointer;
            font-size: 12px;
            transition: all 0.3s;
        }

        .rule-action-btn:hover {
            background: var(--purple-primary);
            border-color: var(--purple-primary);
        }

        /* Create New Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            width: 90%;
            max-width: 500px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transform: translateY(20px);
            transition: transform 0.3s;
        }

        .modal-overlay.active .modal {
            transform: translateY(0);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .modal-header h3 {
            font-size: 20px;
        }

        .modal-close {
            background: transparent;
            border: none;
            color: var(--text-gray);
            font-size: 18px;
            cursor: pointer;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--text-light);
        }

        .form-input {
            width: 100%;
            background: var(--bg-dark);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 12px 15px;
            color: var(--text-light);
            font-size: 14px;
            transition: border-color 0.3s;
        }

        .form-input:focus {
            border-color: var(--orange-accent);
            outline: none;
        }

        .form-select {
            width: 100%;
            background: var(--bg-dark);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 12px 15px;
            color: var(--text-light);
            font-size: 14px;
            transition: border-color 0.3s;
        }

        .form-select:focus {
            border-color: var(--orange-accent);
            outline: none;
        }

        .color-picker {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .color-option {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: transform 0.2s;
        }

        .color-option.selected {
            border-color: var(--orange-accent);
            transform: scale(1.1);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            margin-top: 25px;
        }

        .btn-secondary {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: var(--text-light);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        /* Footer */
        footer {
            background: var(--bg-card);
            border-radius: 20px 20px 0 0;
            padding: 50px 40px 30px;
            margin-top: 50px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 40px;
        }

        .footer-column h3 {
            font-size: 16px;
            margin-bottom: 20px;
        }

        .footer-column p {
            color: var(--text-gray);
            font-size: 13px;
            line-height: 1.7;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: var(--text-light);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            text-align: center;
            color: var(--text-dim);
            font-size: 12px;
        }

        /* Responsive */
        @media (max-width: 968px) {
            .org-dashboard {
                grid-template-columns: 1fr;
            }
            
            .org-sidebar {
                order: 2;
            }
            
            .org-content {
                order: 1;
            }
            
            .labels-grid {
                grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            }
        }

        @media (max-width: 768px) {
            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .top-nav {
                flex-wrap: wrap;
                gap: 15px;
            }

            .top-nav-links {
                width: 100%;
                justify-content: flex-start;
            }
            
            .tab-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .search-box {
                width: 100%;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section {
            animation: fadeIn 0.6s ease-out;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Top Navigation -->
        <nav class="top-nav">
            <a href="v11.html" class="logo-link">
                <div class="logo-icon">✉</div>
                <span class="logo-text">Letters</span>
            </a>
            <ul class="top-nav-links">
                <li><a href="v11.html">Home</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#pricing">Pricing</a></li>
            </ul>
        </nav>

        <!-- Main Header -->
        <header class="main-header">
            <div class="city-logo">
                <h1>LETTERS CITY</h1>
            </div>
            <p class="tagline">Private. Encrypted for you</p>
            <a href="#" class="btn btn-primary">BACK TO INBOX</a>
        </header>

        <!-- Welcome Section -->
        <section class="welcome-section">
            <h2>Email Organization</h2>
            <p>Customize your email experience with labels, folders, and rules</p>
        </section>

        <!-- Organization Dashboard -->
        <div class="org-dashboard">
            <!-- Sidebar -->
            <div class="org-sidebar">
                <h3><i class="fas fa-sliders-h"></i> Organization Tools</h3>
                
                <div class="org-actions">
                    <button class="org-action-btn" id="create-label-btn">
                        <i class="fas fa-tag"></i>
                        <span>Create New Label</span>
                    </button>
                    <button class="org-action-btn" id="create-folder-btn">
                        <i class="fas fa-folder"></i>
                        <span>Create New Folder</span>
                    </button>
                    <button class="org-action-btn" id="create-rule-btn">
                        <i class="fas fa-cogs"></i>
                        <span>Create New Rule</span>
                    </button>
                    <button class="org-action-btn">
                        <i class="fas fa-archive"></i>
                        <span>Archive Manager</span>
                    </button>
                    <button class="org-action-btn">
                        <i class="fas fa-search"></i>
                        <span>Advanced Search</span>
                    </button>
                </div>
                
                <div class="org-stats">
                    <div class="stat-item">
                        <span class="stat-label">Total Labels</span>
                        <span class="stat-value">12</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Total Folders</span>
                        <span class="stat-value">8</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Active Rules</span>
                        <span class="stat-value">5</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Organized Emails</span>
                        <span class="stat-value">1,247</span>
                    </div>
                </div>
            </div>
            
            <!-- Main Content -->
            <div class="org-content">
                <div class="org-tabs">
                    <button class="org-tab active" data-tab="labels">Labels</button>
                    <button class="org-tab" data-tab="folders">Folders</button>
                    <button class="org-tab" data-tab="rules">Rules</button>
                </div>
                
                <!-- Labels Tab -->
                <div class="tab-content active" id="labels-tab">
                    <div class="tab-header">
                        <h3>Your Labels</h3>
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Search labels...">
                        </div>
                    </div>
                    
                    <div class="labels-grid">
                        <div class="label-card">
                            <div class="label-color" style="background-color: #a855f7;"></div>
                            <div class="label-name">Work</div>
                            <div class="label-desc">Emails related to my job and professional work</div>
                            <div class="label-stats">
                                <span>342 emails</span>
                                <span>Last used: Today</span>
                            </div>
                            <div class="label-actions">
                                <button class="label-action-btn"><i class="fas fa-edit"></i></button>
                                <button class="label-action-btn"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        
                        <div class="label-card">
                            <div class="label-color" style="background-color: #ec4899;"></div>
                            <div class="label-name">Personal</div>
                            <div class="label-desc">Personal emails from friends and family</div>
                            <div class="label-stats">
                                <span>156 emails</span>
                                <span>Last used: Yesterday</span>
                            </div>
                            <div class="label-actions">
                                <button class="label-action-btn"><i class="fas fa-edit"></i></button>
                                <button class="label-action-btn"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        
                        <div class="label-card">
                            <div class="label-color" style="background-color: #ff8c00;"></div>
                            <div class="label-name">Important</div>
                            <div class="label-desc">High priority emails that need attention</div>
                            <div class="label-stats">
                                <span>89 emails</span>
                                <span>Last used: Today</span>
                            </div>
                            <div class="label-actions">
                                <button class="label-action-btn"><i class="fas fa-edit"></i></button>
                                <button class="label-action-btn"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        
                        <div class="label-card">
                            <div class="label-color" style="background-color: #10b981;"></div>
                            <div class="label-name">Finance</div>
                            <div class="label-desc">Bank statements, bills, and financial documents</div>
                            <div class="label-stats">
                                <span>67 emails</span>
                                <span>Last used: 2 days ago</span>
                            </div>
                            <div class="label-actions">
                                <button class="label-action-btn"><i class="fas fa-edit"></i></button>
                                <button class="label-action-btn"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Folders Tab -->
                <div class="tab-content" id="folders-tab">
                    <div class="tab-header">
                        <h3>Your Folders</h3>
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" placeholder="Search folders...">
                        </div>
