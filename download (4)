

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Advanced Language & Region - Letters City</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0a0a0f;
            --bg-darker: #05050a;
            --bg-card: #16161f;
            --bg-card-hover: #1d1d28;
            --text-light: #ffffff;
            --text-gray: #8b8b92;
            --text-dim: #5a5a64;
            --purple-primary: #a855f7;
            --purple-dark: #7c3aed;
            --pink-accent: #ec4899;
            --orange-accent: #ff8c00;
            --border-color: rgba(168, 85, 247, 0.3);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Top Navigation */
        .top-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            margin-bottom: 40px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .logo-link {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .logo-icon {
            width: 24px;
            height: 24px;
            background: var(--purple-primary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .logo-text {
            color: var(--text-light);
            font-size: 14px;
            font-weight: 600;
        }

        .top-nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .top-nav-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
        }

        .top-nav-links a:hover {
            color: var(--text-light);
        }

        .top-nav-links a.active {
            color: var(--orange-accent);
        }

        /* Main Header */
        .main-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .city-logo {
            display: inline-block;
            padding: 12px 35px;
            border: 2px solid var(--orange-accent);
            border-radius: 50px;
            margin-bottom: 12px;
        }

        .city-logo h1 {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-light);
        }

        .tagline {
            color: var(--text-gray);
            font-size: 14px;
            margin-bottom: 20px;
        }

        .btn {
            padding: 12px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            border: none;
            display: inline-block;
        }

        .btn-primary {
            background: var(--text-light);
            color: var(--bg-dark);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.2);
        }

        /* Settings Layout */
        .settings-layout {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 30px;
            margin-bottom: 50px;
        }

        /* Settings Sidebar */
        .settings-sidebar {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            height: fit-content;
        }

        .settings-sidebar h3 {
            font-size: 16px;
            margin-bottom: 20px;
            color: var(--text-light);
        }

        .settings-nav {
            list-style: none;
        }

        .settings-nav li {
            margin-bottom: 15px;
        }

        .settings-nav a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .settings-nav a:hover {
            background: var(--bg-card-hover);
            color: var(--text-light);
        }

        .settings-nav a.active {
            background: var(--bg-card-hover);
            color: var(--orange-accent);
            border-left: 3px solid var(--orange-accent);
        }

        /* Settings Content */
        .settings-content {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 35px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .settings-header {
            margin-bottom: 30px;
        }

        .settings-header h2 {
            font-size: 26px;
            margin-bottom: 8px;
        }

        .settings-header p {
            color: var(--text-gray);
            font-size: 14px;
        }

        /* Tabs */
        .settings-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 15px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-gray);
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
        }

        .tab-btn:hover {
            background: var(--bg-card-hover);
            color: var(--text-light);
        }

        .tab-btn.active {
            background: var(--bg-card-hover);
            color: var(--orange-accent);
            border-bottom: 2px solid var(--orange-accent);
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s ease-out;
        }

        /* Language Card */
        .language-card {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .language-card:hover {
            border-color: var(--border-color);
            transform: translateY(-3px);
        }

        .language-card h3 {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .language-card h3 i {
            color: var(--purple-primary);
        }

        .language-search {
            position: relative;
            margin-bottom: 20px;
        }

        .language-search input {
            width: 100%;
            padding: 15px 15px 15px 45px;
            border-radius: 10px;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-light);
            font-size: 14px;
            transition: all 0.3s;
        }

        .language-search input:focus {
            outline: none;
            border-color: var(--orange-accent);
        }

        .language-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-gray);
        }

        .language-categories {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .category-btn {
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-gray);
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.3s;
        }

        .category-btn:hover {
            background: var(--bg-card-hover);
            color: var(--text-light);
        }

        .category-btn.active {
            background: var(--purple-primary);
            color: white;
            border-color: var(--purple-primary);
        }

        .language-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 15px;
            max-height: 400px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .language-grid::-webkit-scrollbar {
            width: 6px;
        }

        .language-grid::-webkit-scrollbar-track {
            background: var(--bg-card);
            border-radius: 10px;
        }

        .language-grid::-webkit-scrollbar-thumb {
            background: var(--purple-primary);
            border-radius: 10px;
        }

        .language-option {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border-radius: 10px;
            background: var(--bg-card);
            cursor: pointer;
            transition: all 0.3s;
        }

        .language-option:hover {
            background: var(--bg-card-hover);
        }

        .language-option.selected {
            border: 1px solid var(--orange-accent);
            background: rgba(255, 140, 0, 0.05);
        }

        .language-flag {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            background: var(--purple-primary);
        }

        .language-info {
            flex: 1;
        }

        .language-info h4 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .language-info p {
            font-size: 13px;
            color: var(--text-gray);
        }

        .language-check {
            color: var(--orange-accent);
            font-size: 18px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .language-option.selected .language-check {
            opacity: 1;
        }

        /* Region Card */
        .region-card {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .region-card:hover {
            border-color: var(--border-color);
            transform: translateY(-3px);
        }

        .region-card h3 {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .region-card h3 i {
            color: var(--purple-primary);
        }

        .region-map {
            height: 200px;
            background: linear-gradient(135deg, #1e3a5f, #2d5a8f);
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .region-map::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml;base64,');
            opacity: 0.3;
        }

        .region-map-content {
            text-align: center;
            z-index: 1;
        }

        .region-map-content i {
            font-size: 40px;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 10px;
        }

        .region-map-content h4 {
            font-size: 18px;
            margin-bottom: 5px;
        }

        .region-map-content p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.7);
        }

        .region-selector {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
        }

        .region-option {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border-radius: 10px;
            background: var(--bg-card);
            cursor: pointer;
            transition: all 0.3s;
        }

        .region-option:hover {
            background: var(--bg-card-hover);
        }

        .region-option.selected {
            border: 1px solid var(--orange-accent);
            background: rgba(255, 140, 0, 0.05);
        }

        .region-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            background: var(--purple-dark);
        }

        .region-info {
            flex: 1;
        }

        .region-info h4 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .region-info p {
            font-size: 13px;
            color: var(--text-gray);
        }

        .region-check {
            color: var(--orange-accent);
            font-size: 18px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .region-option.selected .region-check {
            opacity: 1;
        }

        /* Timezone Card */
        .timezone-card {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .timezone-card:hover {
            border-color: var(--border-color);
            transform: translateY(-3px);
        }

        .timezone-card h3 {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .timezone-card h3 i {
            color: var(--purple-primary);
        }

        .timezone-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        @media (max-width: 768px) {
            .timezone-selector {
                grid-template-columns: 1fr;
            }
        }

        .timezone-group {
            margin-bottom: 20px;
        }

        .timezone-group h4 {
            font-size: 16px;
            margin-bottom: 10px;
            color: var(--text-light);
            padding-bottom: 5px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .timezone-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .timezone-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border-radius: 8px;
            background: var(--bg-card);
            cursor: pointer;
            transition: all 0.3s;
        }

        .timezone-option:hover {
            background: var(--bg-card-hover);
        }

        .timezone-option.selected {
            border: 1px solid var(--orange-accent);
            background: rgba(255, 140, 0, 0.05);
        }

        .timezone-info {
            flex: 1;
        }

        .timezone-info h5 {
            font-size: 14px;
            margin-bottom: 3px;
        }

        .timezone-info p {
            font-size: 12px;
            color: var(--text-gray);
        }

        .timezone-check {
            color: var(--orange-accent);
            font-size: 16px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .timezone-option.selected .timezone-check {
            opacity: 1;
        }

        .current-time {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-gray);
            font-size: 14px;
            margin-top: 15px;
            padding: 15px;
            background: var(--bg-card);
            border-radius: 10px;
        }

        .current-time i {
            color: var(--purple-primary);
        }

        /* Date Format Card */
        .date-format-card {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .date-format-card:hover {
            border-color: var(--border-color);
            transform: translateY(-3px);
        }

        .date-format-card h3 {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .date-format-card h3 i {
            color: var(--purple-primary);
        }

        .format-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }

        .format-option {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            border-radius: 10px;
            background: var(--bg-card);
            cursor: pointer;
            transition: all 0.3s;
        }

        .format-option:hover {
            background: var(--bg-card-hover);
        }

        .format-option.selected {
            border: 1px solid var(--orange-accent);
            background: rgba(255, 140, 0, 0.05);
        }

        .format-info h4 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .format-info p {
            font-size: 13px;
            color: var(--text-gray);
        }

        .format-check {
            color: var(--orange-accent);
            font-size: 18px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .format-option.selected .format-check {
            opacity: 1;
        }

        /* Advanced Settings Card */
        .advanced-card {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
        }

        .advanced-card:hover {
            border-color: var(--border-color);
            transform: translateY(-3px);
        }

        .advanced-card h3 {
            font-size: 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .advanced-card h3 i {
            color: var(--purple-primary);
        }

        .advanced-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .advanced-option {
            padding: 20px;
            border-radius: 10px;
            background: var(--bg-card);
        }

        .advanced-option h4 {
            font-size: 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .advanced-option h4 i {
            color: var(--purple-primary);
        }

        .advanced-option p {
            font-size: 13px;
            color: var(--text-gray);
            margin-bottom: 15px;
        }

        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--bg-card-hover);
            transition: .4s;
            border-radius: 24px;
        }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 16px;
            width: 16px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked + .toggle-slider {
            background-color: var(--purple-primary);
        }

        input:checked + .toggle-slider:before {
            transform: translateX(26px);
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 30px;
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-gray);
            border: 1px solid var(--text-dim);
        }

        .btn-secondary:hover {
            background: var(--bg-card-hover);
            color: var(--text-light);
            border-color: var(--text-light);
        }

        .btn-save {
            background: var(--purple-primary);
            color: white;
        }

        .btn-save:hover {
            background: var(--purple-dark);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(168, 85, 247, 0.3);
        }

        /* Footer */
        footer {
            background: var(--bg-card);
            border-radius: 20px 20px 0 0;
            padding: 50px 40px 30px;
            margin-top: 50px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 40px;
        }

        .footer-column h3 {
            font-size: 16px;
            margin-bottom: 20px;
        }

        .footer-column p {
            color: var(--text-gray);
            font-size: 13px;
            line-height: 1.7;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: var(--text-light);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            text-align: center;
            color: var(--text-dim);
            font-size: 12px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .settings-layout {
                grid-template-columns: 1fr;
            }

            .settings-sidebar {
                order: 2;
            }

            .settings-content {
                order: 1;
            }

            .language-options,
            .format-options,
            .advanced-options {
                grid-template-columns: 1fr;
            }

            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .top-nav {
                flex-wrap: wrap;
                gap: 15px;
            }

            .top-nav-links {
                width: 100%;
                justify-content: flex-start;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section {
            animation: fadeIn 0.6s ease-out;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Top Navigation -->
        <nav class="top-nav">
            <a href="#" class="logo-link">
                <div class="logo-icon">✉</div>
                <span class="logo-text">Letters</span>
            </a>
            <ul class="top-nav-links">
                <li><a href="#">Features</a></li>
                <li><a href="#">Pricing</a></li>
                <li><a href="#" class="active">Settings</a></li>
            </ul>
        </nav>

        <!-- Main Header -->
        <header class="main-header">
            <div class="city-logo">
                <h1>LETTERS CITY</h1>
            </div>
            <p class="tagline">Private. Encrypted for you</p>
        </header>

        <!-- Settings Layout -->
        <div class="settings-layout">
            <!-- Settings Sidebar -->
            <aside class="settings-sidebar">
                <h3>Settings</h3>
                <ul class="settings-nav">
                    <li><a href="#"><i class="fas fa-user"></i> Account</a></li>
