{
  "name": "letters",
  "version": "0.1.0",
  "description": "Letters: The New Email Hosting Platform (built with Forge)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn src/index.ts",
    "forge:server": "FORGE_API_PORT=3333 ts-node src/forge/mcp-server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:init": "ts-node scripts/db-init.ts",
    "db:migrate": "ts-node scripts/db-migrate.ts",
    "db:seed": "ts-node scripts/db-seed.ts"
  },
  "keywords": [
    "email",
    "forge",
    "autonomous",
    "product-foundry"
  ],
  "author": "Mangu Publishers",
  "license": "PROPRIETARY",
  "dependencies": {
    "dotenv": "^16.3.1",
    "pino": "^8.14.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.3.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.0"
  }
}
