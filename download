    <script>
        // Modal functionality
        const setupModal = document.getElementById('setup-modal');
        const backupCodesModal = document.getElementById('backup-codes-modal');
        const closeModal = document.getElementById('close-modal');
        const closeBackupModal = document.getElementById('close-backup-modal');
        const closeBackupCodes = document.getElementById('close-backup-codes');
        const viewBackupCodes = document.getElementById('view-backup-codes');
        const setupSms = document.getElementById('setup-sms');

        // Open setup modal
        document.getElementById('reconfigure-app').addEventListener('click', function() {
            setupModal.classList.add('active');
        });

        // Close setup modal
        closeModal.addEventListener('click', function() {
            setupModal.classList.remove('active');
        });

        // Open backup codes modal
        viewBackupCodes.addEventListener('click', function() {
            backupCodesModal.classList.add('active');
        });

        // Close backup codes modal
        closeBackupModal.addEventListener('click', function() {
            backupCodesModal.classList.remove('active');
        });

        closeBackupCodes.addEventListener('click', function() {
            backupCodesModal.classList.remove('active');
        });

        // Setup SMS verification
        setupSms.addEventListener('click', function() {
            alert('SMS verification setup would be initiated here.');
        });

        // Disable 2FA confirmation
        document.getElementById('disable-2fa').addEventListener('click', function() {
            if (confirm('Are you sure you want to disable two-factor authentication? This will make your account less secure.')) {
                alert('Two-factor authentication has been disabled.');
                // In a real app, this would make an API call to disable 2FA
            }
        });

        // Manage settings
        document.getElementById('manage-settings').addEventListener('click', function() {
            alert('Additional 2FA settings would be shown here.');
        });

        // Add backup phone
        document.getElementById('add-backup-phone').addEventListener('click', function() {
            alert('Backup phone setup would be initiated here.');
        });

        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
            if (event.target === setupModal) {
                setupModal.classList.remove('active');
            }
            if (event.target === backupCodesModal) {
                backupCodesModal.classList.remove('active');
            }
        });

        // Verification code input auto-focus
        const verificationInputs = document.querySelectorAll('.verification-input input');
        verificationInputs.forEach((input, index) => {
            input.addEventListener('input', function() {
                if (this.value.length === 1 && index < verificationInputs.length - 1) {
                    verificationInputs[index + 1].focus();
                }
            });
            
            input.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' && this.value.length === 0 && index > 0) {
                    verificationInputs[index - 1].focus();
                }
            });
        });

        // Add hover effects
        document.querySelectorAll('.method-card, .recovery-method').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.boxShadow = '0 10px 40px rgba(168, 85, 247, 0.2)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.boxShadow = 'none';
            });
        });
    </script>
