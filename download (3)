                                </div>
                            </div>
                            <div class="password-actions">
                                <button class="btn-small btn-outline">Renew</button>
                                <button class="btn-small btn-danger">Revoke</button>
                            </div>
                        </div>

                        <!-- Password Card 4 -->
                        <div class="password-card expired">
                            <div class="password-header">
                                <div class="password-info">
                                    <h3>Android Mail</h3>
                                    <p>Generated 95 days ago</p>
                                </div>
                                <span class="password-status status-expired">Expired</span>
                            </div>
                            <div class="password-details">
                                <div class="password-detail">
                                    <span class="label">Expired:</span>
                                    <span class="value">5 days ago</span>
                                </div>
                                <div class="password-detail">
                                    <span class="label">Permissions:</span>
                                    <span class="value">Read and send</span>
                                </div>
                                <div class="password-detail">
                                    <span class="label">Last used:</span>
                                    <span class="value">2 weeks ago</span>
                                </div>
                            </div>
                            <div class="password-actions">
                                <button class="btn-small btn-outline">Regenerate</button>
                                <button class="btn-small btn-danger">Delete</button>
                            </div>
                        </div>
                    </div>

                    <!-- Empty State (hidden by default) -->
                    <div class="empty-state" style="display: none;">
                        <div class="empty-icon">
                            <i class="fas fa-key"></i>
                        </div>
                        <h3>No App Passwords Yet</h3>
                        <p>You haven't generated any app passwords yet. Create your first one to use with third-party applications.</p>
                        <button class="btn btn-primary">Generate First Password</button>
                    </div>
                </section>

                <!-- Security Tips -->
                <section class="security-section">
                    <div class="security-tips">
                        <h3><i class="fas fa-lightbulb"></i> Security Best Practices</h3>
                        <ul class="tips-list">
                            <li><i class="fas fa-check"></i> Use app passwords only for applications that don't support modern authentication</li>
                            <li><i class="fas fa-check"></i> Regularly review and revoke unused app passwords</li>
                            <li><i class="fas fa-check"></i> Set reasonable expiration dates for all app passwords</li>
                            <li><i class="fas fa-check"></i> Use the minimum required permissions for each application</li>
                            <li><i class="fas fa-check"></i> Never share app passwords - generate unique ones for each application</li>
                            <li><i class="fas fa-check"></i> Consider using two-factor authentication instead of app passwords when possible</li>
