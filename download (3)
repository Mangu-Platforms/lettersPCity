            <div class="footer-bottom">
                <p>&copy; 2025 Letters. All rights reserved. | <a href="#" style="color: var(--purple-primary);">Security & Privacy</a></p>
            </div>
        </footer>
    </div>

    <script>
        // Generate Password Modal
        const generateBtn = document.getElementById('generate-password');
        const modal = document.getElementById('password-modal');
        const closeModal = document.querySelector('.close-modal');
        const copyBtn = document.getElementById('copy-password');
        const downloadBtn = document.getElementById('download-password');

        generateBtn.addEventListener('click', function() {
            modal.classList.add('active');
        });

        closeModal.addEventListener('click', function() {
            modal.classList.remove('active');
        });

        // Close modal when clicking outside
        modal.addEventListener('click', function(e) {
            if (e.target === modal) {
                modal.classList.remove('active');
            }
        });

        // Copy password to clipboard
        copyBtn.addEventListener('click', function() {
            const password = document.getElementById('generated-password').textContent;
            navigator.clipboard.writeText(password).then(() => {
                // Visual feedback
                const originalText = copyBtn.innerHTML;
                copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                copyBtn.style.background = 'rgba(16, 185, 129, 0.3)';
                copyBtn.style.color = 'var(--success-color)';
                
                setTimeout(() => {
                    copyBtn.innerHTML = originalText;
                    copyBtn.style.background = '';
                    copyBtn.style.color = '';
                }, 2000);
            });
        });

        // Download password as text file
        downloadBtn.addEventListener('click', function() {
            const password = document.getElementById('generated-password').textContent;
            const appName = document.getElementById('app-name').value || 'Unknown App';
            const expiration = document.getElementById('expiration').options[document.getElementById('expiration').selectedIndex].text;
            
            const content = `Letters City App Password\n\nApplication: ${appName}\nPassword: ${password}\nExpiration: ${expiration}\nGenerated: ${new Date().toLocaleDateString()}\n\nKeep this information secure and do not share it.`;
            
            const blob = new Blob([content], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `letters-city-password-${appName.replace(/\s+/g, '-').toLowerCase()}.txt`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        });

        // Password card actions
        document.querySelectorAll('.password-actions .btn-danger').forEach(btn => {
            btn.addEventListener('click', function() {
                const card = this.closest('.password-card');
                const appName = card.querySelector('h3').textContent;
                
                if (confirm(`Are you sure you want to revoke the password for ${appName}? This will disconnect the application.`)) {
                    card.style.opacity = '0.5';
                    setTimeout(() => {
                        card.remove();
                        // Check if no passwords left to show empty state
                        if (document.querySelectorAll('.password-card').length === 0) {
                            document.querySelector('.empty-state').style.display = 'block';
                        }
                    }, 300);
                }
            });
        });

        // Form validation
        document.getElementById('app-name').addEventListener('input', function() {
            if (this.value.trim().length > 0) {
                generateBtn.disabled = false;
            } else {
                generateBtn.disabled = true;
            }
        });
    </script>
