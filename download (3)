
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>App Passwords - Letters City</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #0a0a0f;
            --bg-darker: #05050a;
            --bg-card: #16161f;
            --bg-card-hover: #1d1d28;
            --text-light: #ffffff;
            --text-gray: #8b8b92;
            --text-dim: #5a5a64;
            --purple-primary: #a855f7;
            --purple-dark: #7c3aed;
            --pink-accent: #ec4899;
            --orange-accent: #ff8c00;
            --border-color: rgba(168, 85, 247, 0.3);
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --error-color: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Top Navigation */
        .top-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 20px 0;
            margin-bottom: 40px;
        }

        .logo-link {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .logo-icon {
            width: 24px;
            height: 24px;
            background: var(--purple-primary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
        }

        .logo-text {
            color: var(--text-light);
            font-size: 14px;
            font-weight: 600;
        }

        .top-nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .top-nav-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.3s;
        }

        .top-nav-links a:hover {
            color: var(--text-light);
        }

        /* Main Header */
        .main-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .city-logo {
            display: inline-block;
            padding: 12px 35px;
            border: 2px solid var(--orange-accent);
            border-radius: 50px;
            margin-bottom: 12px;
        }

        .city-logo h1 {
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 2px;
            color: var(--text-light);
        }

        .tagline {
            color: var(--text-gray);
            font-size: 14px;
            margin-bottom: 20px;
        }

        .btn {
            padding: 12px 32px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            border: none;
            display: inline-block;
        }

        .btn-primary {
            background: var(--text-light);
            color: var(--bg-dark);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.2);
        }

        /* Settings Layout */
        .settings-container {
            display: flex;
            gap: 30px;
            margin-bottom: 50px;
        }

        .settings-sidebar {
            flex: 0 0 250px;
            background: var(--bg-card);
            border-radius: 20px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            height: fit-content;
        }

        .settings-content {
            flex: 1;
        }

        .settings-nav {
            list-style: none;
        }

        .settings-nav li {
            margin-bottom: 15px;
        }

        .settings-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--text-gray);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 12px 15px;
            border-radius: 10px;
            transition: all 0.3s;
        }

        .settings-nav a:hover {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-light);
        }

        .settings-nav a.active {
            background: rgba(168, 85, 247, 0.1);
            color: var(--purple-primary);
            border-left: 3px solid var(--orange-accent);
        }

        .settings-nav i {
            font-size: 16px;
            width: 20px;
        }

        /* Security Sections */
        .security-section {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 35px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .section-header h2 {
            font-size: 22px;
        }

        .section-header p {
            color: var(--text-gray);
            font-size: 14px;
        }

        /* Security Status */
        .security-status {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: var(--bg-darker);
            border-radius: 15px;
            margin-bottom: 30px;
            border-left: 4px solid var(--success-color);
        }

        .security-status.warning {
            border-left-color: var(--warning-color);
        }

        .security-status.error {
            border-left-color: var(--error-color);
        }

        .status-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .security-status .status-icon {
            background: rgba(16, 185, 129, 0.2);
            color: var(--success-color);
        }

        .security-status.warning .status-icon {
            background: rgba(245, 158, 11, 0.2);
            color: var(--warning-color);
        }

        .security-status.error .status-icon {
            background: rgba(239, 68, 68, 0.2);
            color: var(--error-color);
        }

        .status-content h3 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .status-content p {
            color: var(--text-gray);
            font-size: 14px;
        }

        /* App Passwords Grid */
        .passwords-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .password-card {
            background: var(--bg-card);
            border-radius: 15px;
            padding: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s;
            position: relative;
        }

        .password-card:hover {
            border-color: rgba(168, 85, 247, 0.3);
            transform: translateY(-3px);
        }

        .password-card.expired {
            opacity: 0.7;
            border-color: rgba(239, 68, 68, 0.3);
        }

        .password-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .password-info h3 {
            font-size: 16px;
            margin-bottom: 5px;
        }

        .password-info p {
            color: var(--text-gray);
            font-size: 13px;
        }

        .password-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
        }

        .status-active {
            background: rgba(16, 185, 129, 0.2);
            color: var(--success-color);
        }

        .status-expired {
            background: rgba(239, 68, 68, 0.2);
            color: var(--error-color);
        }

        .status-warning {
            background: rgba(245, 158, 11, 0.2);
            color: var(--warning-color);
        }

        .password-details {
            margin-bottom: 20px;
        }

        .password-detail {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .password-detail .label {
            color: var(--text-gray);
        }

        .password-detail .value {
            color: var(--text-light);
            font-weight: 500;
        }

        .password-actions {
            display: flex;
            gap: 10px;
        }

        .btn-small {
            padding: 8px 15px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
        }

        .btn-outline {
            background: transparent;
            color: var(--text-light);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .btn-outline:hover {
            border-color: var(--orange-accent);
        }

        .btn-danger {
            background: rgba(239, 68, 68, 0.2);
            color: var(--error-color);
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .btn-danger:hover {
            background: rgba(239, 68, 68, 0.3);
        }

        /* Generate Password Form */
        .generate-form {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-light);
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            background: var(--bg-card);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            color: var(--text-light);
            font-size: 14px;
            transition: all 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--orange-accent);
            box-shadow: 0 0 0 2px rgba(255, 140, 0, 0.2);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .checkbox-group input {
            accent-color: var(--purple-primary);
        }

        .checkbox-group label {
            font-size: 14px;
            color: var(--text-light);
            margin-bottom: 0;
        }

        .form-actions {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-top: 25px;
        }

        /* Generated Password Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            width: 90%;
            max-width: 500px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transform: translateY(20px);
            transition: all 0.3s;
        }

        .modal-overlay.active .modal {
            transform: translateY(0);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .modal-header h3 {
            font-size: 18px;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--text-gray);
            font-size: 18px;
            cursor: pointer;
            transition: color 0.3s;
        }

        .close-modal:hover {
            color: var(--text-light);
        }

        .password-display {
            background: var(--bg-darker);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .password-value {
            font-family: 'Courier New', monospace;
            font-size: 18px;
            letter-spacing: 2px;
            margin-bottom: 15px;
            word-break: break-all;
            color: var(--success-color);
        }

        .password-actions-horizontal {
            display: flex;
            gap: 10px;
        }

        .btn-full {
            flex: 1;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-success {
            background: rgba(16, 185, 129, 0.2);
            color: var(--success-color);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .btn-success:hover {
            background: rgba(16, 185, 129, 0.3);
        }

        /* Security Tips */
        .security-tips {
            background: var(--bg-darker);
            border-radius: 15px;
            padding: 25px;
            border-left: 4px solid var(--purple-primary);
        }

        .security-tips h3 {
            font-size: 16px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .security-tips h3 i {
            color: var(--purple-primary);
        }

        .tips-list {
            list-style: none;
        }

        .tips-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 12px;
            font-size: 14px;
            color: var(--text-gray);
        }

        .tips-list li i {
            color: var(--purple-primary);
            margin-top: 3px;
            font-size: 12px;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
        }

        .empty-icon {
            font-size: 50px;
            color: var(--text-dim);
            margin-bottom: 20px;
        }

        .empty-state h3 {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: var(--text-gray);
            font-size: 14px;
            max-width: 400px;
            margin: 0 auto 25px;
        }

        /* Footer */
        footer {
            background: var(--bg-card);
            border-radius: 20px 20px 0 0;
            padding: 50px 40px 30px;
            margin-top: 50px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
            margin-bottom: 40px;
        }

        .footer-column h3 {
            font-size: 16px;
            margin-bottom: 20px;
        }

        .footer-column p {
            color: var(--text-gray);
            font-size: 13px;
            line-height: 1.7;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-gray);
            text-decoration: none;
            font-size: 13px;
            transition: color 0.3s;
        }

        .footer-links a:hover {
            color: var(--text-light);
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            text-align: center;
            color: var(--text-dim);
            font-size: 12px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .settings-container {
                flex-direction: column;
            }
            
            .settings-sidebar {
                flex: none;
                width: 100%;
            }
            
            .passwords-grid {
                grid-template-columns: 1fr;
            }
            
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .footer-content {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .top-nav {
                flex-wrap: wrap;
                gap: 15px;
            }
            
            .top-nav-links {
                width: 100%;
                justify-content: flex-start;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section {
            animation: fadeIn 0.6s ease-out;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Top Navigation -->
        <nav class="top-nav">
            <a href="#" class="logo-link">
                <div class="logo-icon">✉</div>
                <span class="logo-text">Letters</span>
            </a>
            <ul class="top-nav-links">
                <li><a href="#">Dashboard</a></li>
                <li><a href="#">Settings</a></li>
                <li><a href="#">Help Center</a></li>
            </ul>
        </nav>

        <!-- Main Header -->
        <header class="main-header">
            <div class="city-logo">
                <h1>LETTERS CITY</h1>
            </div>
            <p class="tagline">Private. Encrypted for you</p>
        </header>

        <!-- Settings Container -->
        <div class="settings-container">
            <!-- Settings Sidebar -->
            <div class="settings-sidebar">
                <ul class="settings-nav">
                    <li><a href="#"><i class="fas fa-user-shield"></i> Security Overview</a></li>
                    <li><a href="#"><i class="fas fa-key"></i> Password & Authentication</a></li>
                    <li><a href="#" class="active"><i class="fas fa-mobile-alt"></i> App Passwords</a></li>
                    <li><a href="#"><i class="fas fa-shield-alt"></i> Two-Factor Authentication</a></li>
                    <li><a href="#"><i class="fas fa-lock"></i> Encryption</a></li>
                    <li><a href="#"><i class="fas fa-history"></i> Login Activity</a></li>
                    <li><a href="#"><i class="fas fa-user-check"></i> Account Permissions</a></li>
                </ul>
            </div>

            <!-- Settings Content -->
            <div class="settings-content">
                <!-- Security Status -->
                <section class="security-section">
                    <div class="section-header">
                        <div>
                            <h2>App Passwords</h2>
                            <p>Generate passwords for third-party applications</p>
                        </div>
                    </div>

                    <div class="security-status">
                        <div class="status-icon">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="status-content">
                            <h3>App Passwords Active</h3>
                            <p>You have 3 active app passwords. Remember to revoke unused passwords to maintain security.</p>
                        </div>
                    </div>
                </section>

                <!-- Generate New Password -->
                <section class="security-section">
                    <div class="section-header">
                        <div>
                            <h2>Generate New App Password</h2>
                            <p>Create a unique password for a specific application</p>
                        </div>
                    </div>

                    <div class="generate-form">
                        <div class="form-group">
                            <label for="app-name">Application Name</label>
                            <input type="text" id="app-name" class="form-control" placeholder="e.g., Outlook Desktop, Thunderbird, iPhone Mail">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="expiration">Expiration</label>
                                <select id="expiration" class="form-control">
                                    <option value="30">30 days</option>
                                    <option value="90" selected>90 days</option>
                                    <option value="180">6 months</option>
                                    <option value="365">1 year</option>
                                    <option value="0">Never (not recommended)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="permissions">Permissions</label>
                                <select id="permissions" class="form-control">
                                    <option value="read-only">Read only</option>
                                    <option value="read-send" selected>Read and send</option>
                                    <option value="full-access">Full account access</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Restrictions</label>
                            <div class="checkbox-group">
                                <input type="checkbox" id="ip-restrict" checked>
                                <label for="ip-restrict">Restrict to your current IP address</label>
                            </div>
                            <div class="checkbox-group">
                                <input type="checkbox" id="device-restrict">
                                <label for="device-restrict">Restrict to this device only</label>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button class="btn btn-outline">Cancel</button>
                            <button class="btn btn-primary" id="generate-password">Generate Password</button>
                        </div>
                    </div>
                </section>

                <!-- Active App Passwords -->
                <section class="security-section">
                    <div class="section-header">
                        <div>
                            <h2>Active App Passwords</h2>
                            <p>Manage your existing application passwords</p>
                        </div>
                    </div>

                    <div class="passwords-grid">
                        <!-- Password Card 1 -->
                        <div class="password-card">
                            <div class="password-header">
                                <div class="password-info">
                                    <h3>Outlook Desktop</h3>
                                    <p>Generated 15 days ago</p>
                                </div>
                                <span class="password-status status-active">Active</span>
                            </div>
                            <div class="password-details">
                                <div class="password-detail">
                                    <span class="label">Expires:</span>
                                    <span class="value">75 days</span>
                                </div>
                                <div class="password-detail">
                                    <span class="label">Permissions:</span>
                                    <span class="value">Read and send</span>
                                </div>
                                <div class="password-detail">
                                    <span class="label">Last used:</span>
                                    <span class="value">2 hours ago</span>
                                </div>
                            </div>
                            <div class="password-actions">
                                <button class="btn-small btn-outline">View Details</button>
                                <button class="btn-small btn-danger">Revoke</button>
                            </div>
                        </div>

                        <!-- Password Card 2 -->
                        <div class="password-card">
                            <div class="password-header">
                                <div class="password-info">
                                    <h3>iPhone Mail</h3>
                                    <p>Generated 45 days ago</p>
                                </div>
                                <span class="password-status status-active">Active</span>
                            </div>
                            <div class="password-details">
                                <div class="password-detail">
                                    <span class="label">Expires:</span>
                                    <span class="value">45 days</span>
                                </div>
                                <div class="password-detail">
                                    <span class="label">Permissions:</span>
                                    <span class="value">Full access</span>
                                </div>
                                <div class="password-detail">
                                    <span class="label">Last used:</span>
                                    <span class="value">Yesterday</span>
                                </div>
                            </div>
                            <div class="password-actions">
                                <button class="btn-small btn-outline">View Details</button>
                                <button class="btn-small btn-danger">Revoke</button>
                            </div>
                        </div>

                        <!-- Password Card 3 -->
                        <div class="password-card">
                            <div class="password-header">
                                <div class="password-info">
                                    <h3>Thunderbird</h3>
                                    <p>Generated 80 days ago</p>
                                </div>
                                <span class="password-status status-warning">Expiring soon</span>
                            </div>
                            <div class="password-details">
                                <div class="password-detail">
                                    <span class="label">Expires:</span>
