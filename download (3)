                    <p style="margin-bottom: 10px; color: var(--text-gray); font-size: 14px;">Use this password in your application. You won't be able to see it again.</p>
                    <div class="password-value" id="generated-password">xkT9-8mN4-pQr2-wXz7</div>
                    <div style="display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-gray);">
                        <i class="fas fa-clock"></i>
                        <span>Expires: October 15, 2025</span>
                    </div>
                </div>
                <div class="password-actions-horizontal">
                    <button class="btn-full btn-outline" id="copy-password">
                        <i class="fas fa-copy"></i>
                        Copy Password
                    </button>
                    <button class="btn-full btn-success" id="download-password">
                        <i class="fas fa-download"></i>
                        Download
